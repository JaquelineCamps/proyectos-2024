@model peliculas.Models.Pelicula

@{
    ViewData["Title"] = "Details";
}
<div>
    <h4>Datos de la Pelicula</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.titulo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.titulo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.autor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.autor)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.sinopsis)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.sinopsis)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.duracion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.duracion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.clasificacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.clasificacion)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdPelicula">Modificar</a> |
    <a asp-action="Index">Regresar a la lista de peliculas</a>
</div>
